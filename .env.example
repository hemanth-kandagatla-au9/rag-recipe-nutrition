# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=your_groq_api_key_here
# URL the Streamlit app uses to reach the backend (Step 2 default)
BACKEND_URL=http://localhost:8000
# Cross-encoder score below which questions are refused (calibrated: in-scope >= +2.28, out-of-scope <= -3.35)
REFUSE_BELOW=-1.0
# gpt-oss reasoning effort (low/medium/high); leave empty to omit the parameter
GROQ_REASONING_EFFORT=low
# Judge model for RAGAS scoring (default gpt-oss-20b keeps scoring off the answer model's daily quota)
# GROQ_JUDGE_MODEL=openai/gpt-oss-20b
# Set to 0 to disable per-query RAGAS scoring (e.g. when the free quota runs low)
# RAGAS_LIVE=1
